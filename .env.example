OPENAI_API_KEY=sk-your-key-here
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_DRAFT_MODEL=gpt-4o-mini
DRAFT_MAX_CHARS=1200
AUDIO_CHUNK_MINUTES=10
TIMEZONE=America/Los_Angeles

# yt-dlp: YouTube needs a JS runtime. Use "node" if you have Node.js, or "deno" for Deno.
# Leave empty to use yt-dlp default (Deno). Install Node from https://nodejs.org (v20+) or Deno from https://deno.com
YT_DLP_JS_RUNTIMES=node

# ffmpeg: Leave empty to auto-detect from PATH. If yt-dlp says "ffprobe/ffmpeg not found", set this to the
# directory containing ffmpeg and ffprobe (e.g. /opt/homebrew/bin or /usr/local/bin).
# FFMPEG_LOCATION=
