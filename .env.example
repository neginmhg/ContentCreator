# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here

# Database Configuration
# For production (PostgreSQL): DATABASE_URL=postgresql://user:password@host:port/database
# For development (SQLite): Leave empty to use SQLite
DATABASE_URL=

# OpenAI Models
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_DRAFT_MODEL=gpt-4o-mini

# Content Generation
DRAFT_MAX_CHARS=1200
AUDIO_CHUNK_MINUTES=10

# Timezone
TIMEZONE=America/Los_Angeles

# yt-dlp Configuration
# Options: node, deno, bun, quickjs (must be installed)
YT_DLP_JS_RUNTIMES=node

# ffmpeg Configuration
# Path to ffmpeg binary or directory containing ffmpeg/ffprobe
# Leave empty to auto-detect from PATH
FFMPEG_LOCATION=
